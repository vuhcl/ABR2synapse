# =============================================================================
# Monorepo ignore rules (Practicum root + ABR2synapse subtree)
# =============================================================================
# Canonical location: ABR2synapse/.gitignore (edit here).
# Repo root also has `.gitignore` with the same rules so Git applies them from the
# monorepo root on clone. After changing this file, sync the root copy:
#   cp ABR2synapse/.gitignore .gitignore
# All patterns are relative to the repository root (where .git lives).
#
# When you promote ABR2synapse/ to the sole repo root, drop the `ABR2synapse/`
# path prefixes below and keep `figures/cache/`, `utils/`, etc. at top level.

# --- Python / tooling cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
.tox/
.nox/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Generic cache dirs ---
.cache/
*.cache

# --- Virtual environments ---
.venv/
.venv-deck-qa/
venv/
ENV/
env/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.specstory/

# --- Local scratch (names starting with underscore) ---
_*
!**/__init__.py
!**/__main__.py

# --- Nested git metadata (e.g. abranalysis/) ---
.git/

# --- Git bundle backups ---
*.bundle

# --- Large / local-only trees at repo root ---
abr_data/
liberman_wpz/
17593142/
original/

# --- ABR2synapse project layout ---
ABR2synapse/figures/cache/
ABR2synapse/figures/presentation/
# Keep optional placeholder if you add one:
# !ABR2synapse/figures/cache/.gitkeep

# Root-level figures/ (presentation deck, wide/long exports)
figures/cache/
figures/presentation/

# --- Artifacts: tabular / serialized data ---
*.parquet
*.parq
*.feather
*.orc
*.avro
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5

# --- Artifacts: structured text / exports ---
*.json
*.jsonl
*.ndjson
*.html
*.htm
*.xml
*.md

# --- Artifacts: images ---
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.ico
*.svg

# --- Artifacts: archives / large binaries ---
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar

# --- ML / experiment outputs (common defaults) ---
wandb/
mlruns/
lightning_logs/
runs/
outputs/
artifacts/
